{
  "name": "gemini-vision-mcp",
  "version": "0.1.0",
  "description": "MCP server that calls the Gemini vision model (default gemini-3.5-flash) to analyze images. GitHub repo: arieslee/deepseek-vision-mcp (npm name differs because deepseek-vision-mcp is taken on npm).",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "gemini-vision-mcp": "./dist/index.js"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "node dist/smoke-test.js"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arieslee/deepseek-vision-mcp.git"
  },
  "keywords": [
    "mcp",
    "modelcontextprotocol",
    "gemini",
    "vision",
    "image-recognizer"
  ],
  "license": "MIT"
}
